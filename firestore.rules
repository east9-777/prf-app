rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {

    function authed() {
      return request.auth != null;
    }

    function isAdminEmail() {
      return authed() && request.auth.token.email == 'leivisonbrito64@gmail.com';
    }

    function userDocExists() {
      return exists(/databases/$(database)/documents/users/$(request.auth.uid));
    }

    function userDoc() {
      return get(/databases/$(database)/documents/users/$(request.auth.uid)).data;
    }

    function isAdmin() {
      return isAdminEmail() || (authed() && userDocExists() && userDoc().role == 'administrador');
    }

    function isInstrutor() {
      return authed() && userDocExists() && userDoc().role == 'instrutor';
    }

    function isStaff() {
      return isAdmin() || isInstrutor();
    }

    function onlyInteractionFields(fields) {
      return fields.hasOnly(['likes', 'likedBy', 'savedBy']);
    }

    // ── Usuários ───────────────────────────────────────────────
    match /users/{userId} {
      allow read: if authed();

      allow create: if authed() && request.auth.uid == userId;

      allow update: if authed() && (
        (request.auth.uid == userId &&
          !request.resource.data.diff(resource.data)
            .affectedKeys().hasAny(['role', 'isSuspended', 'isBanned']))
        ||
        isAdmin()
      );

      allow delete: if isAdmin();
    }

    // ── Posts de novidades (instrutores/admins) ────────────────
    match /posts/{postId} {
      allow read: if authed();

      allow create: if isStaff();

      allow update: if authed() && (
        resource.data.authorId == request.auth.uid
        || isAdmin()
        || onlyInteractionFields(request.resource.data.diff(resource.data).affectedKeys())
      );

      allow delete: if authed() && (
        resource.data.authorId == request.auth.uid || isAdmin()
      );
    }

    // ── Posts da comunidade (todos os usuários) ────────────────
    match /communityPosts/{postId} {
      allow read: if authed();

      allow create: if authed();

      allow update: if authed() && (
        resource.data.authorId == request.auth.uid
        || isAdmin()
        || onlyInteractionFields(request.resource.data.diff(resource.data).affectedKeys())
      );

      allow delete: if authed() && (
        resource.data.authorId == request.auth.uid || isAdmin()
      );
    }

    // ── Comentários ────────────────────────────────────────────
    match /comments/{commentId} {
      allow read: if authed();

      allow create: if authed();

      allow update: if authed() && (
        resource.data.authorId == request.auth.uid
        || isAdmin()
        || request.resource.data.diff(resource.data).affectedKeys().hasOnly(['likes', 'likedBy'])
      );

      allow delete: if authed() && (
        resource.data.authorId == request.auth.uid || isAdmin()
      );
    }

    // ── Notificações ───────────────────────────────────────────
    match /notifications/{userId}/items/{notifId} {
      allow read, write: if authed() && request.auth.uid == userId;
      allow write: if isAdmin();
    }

    // ── Cronograma ─────────────────────────────────────────────
    match /schedules/{userId}/items/{itemId} {
      allow read, write: if authed() && request.auth.uid == userId;
    }
  }
}

rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {

    function authed() {
      return request.auth != null;
    }

    function userDoc() {
      return get(/databases/$(database)/documents/users/$(request.auth.uid)).data;
    }

    function isAdmin() {
      return authed() && userDoc().role == 'administrador';
    }

    function isInstrutor() {
      return authed() && userDoc().role == 'instrutor';
    }

    function isStaff() {
      return isAdmin() || isInstrutor();
    }

    // ── Usuários ───────────────────────────────────────────────
    match /users/{userId} {
      allow read: if authed();

      allow create: if authed() && request.auth.uid == userId;

      allow update: if authed() && (
        // Próprio usuário pode atualizar tudo EXCETO cargo
        (request.auth.uid == userId &&
          !request.resource.data.diff(resource.data)
            .affectedKeys().hasAny(['role', 'isSuspended', 'isBanned']))
        ||
        // Admin pode atualizar qualquer campo de qualquer usuário
        isAdmin()
      );

      allow delete: if isAdmin();
    }

    // ── Posts de novidades (instrutores/admins) ────────────────
    match /posts/{postId} {
      allow read: if authed();

      allow create: if isStaff();

      allow update: if authed() && (
        resource.data.authorId == request.auth.uid || isAdmin()
      );

      allow delete: if authed() && (
        resource.data.authorId == request.auth.uid || isAdmin()
      );
    }

    // ── Posts da comunidade (todos os usuários) ────────────────
    match /communityPosts/{postId} {
      allow read: if authed();

      allow create: if authed();

      allow update: if authed() && (
        resource.data.authorId == request.auth.uid || isAdmin()
      );

      allow delete: if authed() && (
        resource.data.authorId == request.auth.uid || isAdmin()
      );
    }

    // ── Comentários ────────────────────────────────────────────
    match /comments/{commentId} {
      allow read: if authed();

      allow create: if authed();

      allow update: if authed() && (
        resource.data.authorId == request.auth.uid || isAdmin()
      );

      allow delete: if authed() && (
        resource.data.authorId == request.auth.uid || isAdmin()
      );
    }

    // ── Notificações ───────────────────────────────────────────
    match /notifications/{userId}/items/{notifId} {
      allow read, write: if authed() && request.auth.uid == userId;
      allow write: if isAdmin();
    }

    // ── Cronograma ─────────────────────────────────────────────
    match /schedules/{userId}/items/{itemId} {
      allow read, write: if authed() && request.auth.uid == userId;
    }
  }
}
